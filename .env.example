# LLM
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# WRITER_MODEL=claude-sonnet-5-5
# REVIEWER_MODEL=claude-haiku-5-5

# Agent
# MAX_REVISIONS=2
# CHECKPOINT_DB=wpagent.sqlite

# API (wpagent serve). The n8n webhook stays disabled while WEBHOOK_SECRET is empty.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Bearer token for the /runs endpoints. Required to listen on anything but loopback.
# API_TOKEN=
# API_HOST=127.0.0.1
# API_PORT=8000
# MAX_CONCURRENT_RUNS=3
